// samaya Studio resources: the icon and the version information.
#include <winver.h>

IDI_APP ICON "studio.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0, 1, 0, 0
PRODUCTVERSION 0, 1, 0, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Team VyomX"
      VALUE "FileDescription", "samaya Studio"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductName", "samaya"
      VALUE "ProductVersion", "0.1.0"
      VALUE "OriginalFilename", "samaya-studio.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
